# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # channel or group to push signals to
TELEGRAM_ADMIN_IDS=        # comma-separated user IDs allowed to run admin commands

# Exchanges (public market data needs no keys — keys only matter for a later
# auto-trading phase that places real orders)
EXCHANGES=binance,bybit
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Database (local SQLite file — no external DB service needed)
# On Railway, point this at a path inside an attached Volume so data
# survives redeploys, e.g. DB_PATH=/data/sunnex.db
DB_PATH=./data/sunnex.db

# Strategy config
PAIRS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAMES=15m,1h,4h
MIN_SIGNAL_SCORE=70
MIN_RR=1.5
SPREAD_LIMIT_PIPS=3

# --- MT5 live trading (optional) ---
# Leave all of this blank to keep the bot signals-only. Set these to enable
# real order placement via MetaApi.cloud (https://metaapi.cloud). Even with
# these set, no order fires until an admin sends /enabletrading in Telegram
# — that gate defaults to OFF on every fresh deploy.
#
# STRONGLY test on a demo account first — set METAAPI_ACCOUNT_ID to your
# demo account's MetaApi id, confirm trades land correctly, THEN consider
# switching to a live account id.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Maps our crypto pairs to your broker's actual MT5 symbol names — these
# vary a LOT between brokers (BTCUSD, BTCUSDm, BTCUSD.a, etc). Check your
# MT5 Market Watch for the exact spelling. Must be valid JSON, one line.
MT5_SYMBOL_MAP={"BTC/USDT":"BTCUSD","ETH/USDT":"ETHUSD","SOL/USDT":"SOLUSD"}

# Safety caps — all enforced before an order is ever sent
MT5_LOT_SIZE=0.01
MT5_MAX_OPEN_POSITIONS=3
MT5_MAX_DAILY_LOSS=-50

# App
PORT=3000
LOG_LEVEL=info
